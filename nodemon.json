{
  "env": {
    "NODE_ENV": "development"
  },
  "watch": ["src", "config"],
  "ignore": [
    "logs/**",
    "*.log",
    "data/**",
    ".env",
    "node_modules/**",
    ".git/**",
    ".vscode/**",
    ".idea/**",
    "coverage/**",
    ".DS_Store",
    "**/.DS_Store",
    "src/.DS_Store",
    "config/.DS_Store",
    "*.swp",
    "*.swo",
    "*~"
  ],
  "ext": "js,json",
  "exec": "node src/index.js",
  "delay": 2500,
  "legacyWatch": true
}
